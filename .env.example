# =============================================================
# PROUX — variables d'environnement
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` n'est PAS versionné.
# =============================================================

# — Envoi des demandes de devis (Resend) —
# Clé API : https://resend.com/api-keys
# Tant que cette variable est vide, le formulaire fonctionne en
# « dry-run » : la demande est validée et loggée, sans email envoyé.
RESEND_API_KEY=

# Expéditeur des emails. Doit être une adresse d'un domaine VÉRIFIÉ
# dans Resend (https://resend.com/domains). En attendant la
# vérification du domaine proux-couverture.fr, on peut utiliser onboarding@resend.dev.
QUOTE_FROM_EMAIL="PROUX — Site <devis@proux-couverture.fr>"

# Destinataire des demandes de devis (boîte de l'artisan).
QUOTE_TO_EMAIL=contact@proux-couverture.fr
